body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
    color: #333;
}

header {
    background-color: #333;
    color: #fff;
    padding: 1em 0;
    text-align: center;
}

header h1 {
    margin: 0;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

.hero {
    background-color: #4CAF50;
    color: #fff;
    padding: 2em;
    text-align: center;
}

.libros {
    padding: 2em;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
}

.libro {
    background-color: #fff;
    padding: 1em;
    margin: 1em;
    border: 1px solid #ddd;
    border-radius: 5px;
    width: 30%;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.libro img {
    max-width: 100%;
    height: auto;
    border-radius: 5px;
}

.libro h3 {
    margin-top: 0;
}

.libro p {
    color: #666;
}

.libro a {
    display: inline-block;
    margin-top: 1em;
    color: #333;
    text-decoration: none;
    background-color: #eee;
    padding: 0.5em 1em;
    border-radius: 5px;
}

.libro a:hover {
    background-color: #ddd;
}

footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 1em 0;
    position: fixed;
    width: 100%;
    bottom: 0;
}
